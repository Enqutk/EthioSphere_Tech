# Local Postgres:
# DATABASE_URL="postgresql://user:password@localhost:5432/programmers_world"
#
# Neon (use the pooled connection string from the dashboard; it usually ends in -pooler...neon.tech).
# If connections fail after idle time, open the Neon console once to wake the database, then retry.
# Example shape (copy yours from Neon — do not commit real passwords):
# Add connect_timeout (seconds) so cold/failed DB fails in ~15s instead of hanging ~2min behind the Vite proxy:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DATABASE_URL="postgresql://user:password@localhost:5432/programmers_world"
# Min distinct challenges a Newbie must complete before they can create challenges (default 3).
# CHALLENGE_CREATE_MIN_COMPLETED=3

JWT_SECRET=your-super-secret-jwt-key-change-in-production
SERVER_PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Google OAuth (optional — enables "Continue with Google")
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI (or API_PUBLIC_URL + /api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# API_PUBLIC_URL=http://localhost:4000

# Optional: password for seeded admin@programmers.world (default: admin1234). Seed updates this user on each run.
# ADMIN_SEED_PASSWORD=

# GitHub REST API (strongly recommended in production — required on Vercel deploy)
# Classic personal access token with no scopes; only used for public repo/user data.
# Without it: 60 requests/hour/IP (unauthenticated). With it: 5,000/hour.
# Create at https://github.com/settings/tokens (classic, no scopes checked)
# GITHUB_TOKEN=ghp_...

# Optional: password reset emails via Resend (https://resend.com)
# Without RESEND_API_KEY, reset links are logged to the server console in development only.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Programmers World <noreply@yourdomain.com>

# Set to 1 to skip DNS MX/A checks on register (offline/dev only). Production should leave unset.
# EMAIL_SKIP_DNS_CHECK=1

# Optional: Firebase Cloud Messaging (browser push). Leave unset to skip push; Socket.io in-app still works.
# Use a Firebase service account (Project settings → Service accounts → Generate new private key)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or one-line JSON:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
