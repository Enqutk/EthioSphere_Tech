# Root env reference — this monorepo uses per-package env files.
#
# Local setup:
#   cp server/.env.example server/.env
#   cp client/.env.example client/.env
#
# See server/.env.example for API, database, OAuth, GitHub, and email vars.
# See client/.env.example for VITE_API_BASE_URL and VITE_SITE_URL.
