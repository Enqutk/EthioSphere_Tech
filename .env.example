# Copy to .env and fill in values

# Server (Express API)
SERVER_PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/programmers_world"

# Optional: GitHub PAT for higher API rate limits (public profile + repo checks)
# GITHUB_TOKEN=
# GITHUB_API_USER_AGENT=ProgrammersWorld/1.0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# GitHub OAuth (optional for MVP)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Client (Next.js) - for API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000
