VITE_API_BASE_URL=http://localhost:4000
# Required in production: your separate API Vercel URL (NOT the frontend URL).
# Example: VITE_API_BASE_URL=https://programmers-world-api.vercel.app
# On same-host VPS (Traefik): use the site origin so /api and /socket.io share cookies, e.g.
# VITE_API_BASE_URL=https://pw.aklildr.com
# Public site URL for share previews (optional — improves og:url in usePageMeta)
# VITE_SITE_URL=https://your-frontend.vercel.app

# Optional: Firebase web push (Cloud Messaging). Same project as server service account.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
